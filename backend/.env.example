# Copy this file to .env and fill in your values.
# Never commit .env to Git — it is in .gitignore.
#
# For local dev: only API keys are needed (DB uses Windows Auth).
# For Docker:    all variables are required.

# ── Database (Docker only — local dev uses Windows Auth automatically) ───────
DB_PASSWORD=YourStrong!Passw0rd   # min 8 chars, 1 uppercase, 1 number, 1 symbol

# ── AI providers (at least one of Gemini / OpenAI / Anthropic required) ─────
GEMINI_API_KEY=AIza...             # free tier — primary provider
OPENAI_API_KEY=sk-...              # optional fallback
ANTHROPIC_API_KEY=sk-ant-...       # optional fallback
